# Banco de dados (SQLite local, sem servidor - nao precisa configurar nada)
DATABASE_URL=sqlite:///./descarteia.db

# Provedor de IA em uso: Gemini (o router usa GeminiClassificacaoIAService por
# padrao). Gere uma chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Opcional - modelo do Gemini a usar
GEMINI_MODEL=gemini-3.6-flash

# Alternativa (nao usada por padrao, mas o codigo ja aceita - ver
# GroqClassificacaoIAService): chave gratuita do Groq, gere em
# https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
