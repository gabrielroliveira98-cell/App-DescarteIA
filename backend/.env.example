# Banco de dados
# Local: SQLite, nao precisa configurar nada
DATABASE_URL=sqlite:///./descarteia.db
# Na nuvem (Supabase): copie a "Connection string" do Session pooler, algo como
# DATABASE_URL=postgresql://postgres.xxxx:SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Gere uma chave gratuita em https://console.groq.com/keys
GROQ_API_KEY=
# Opcional - modelo do Groq a usar
GROQ_MODEL=openai/gpt-oss-20b
